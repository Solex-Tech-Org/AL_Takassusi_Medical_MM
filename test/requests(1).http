### validateShared - valid
# EXPECT: validate مبيسجّلش حاجة في الـ DB
# @name sh_val_ok
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/validateShared
Authorization: {{auth}}
Content-Type: application/json

{
  "input": {
    "PostingDate": "2026-10-14",
    "Hospital": "01",
    "Modality": "01",
    "Items": [
