### postShared - valid
# EXPECT: مفيش ID بيرجع هنا؛ بتعرف إنه اتعمل من SAPMaterialDocument، وتدوّر عليه في SharedConsumptions
# @name sh_post_ok
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/postShared
Authorization: {{auth}}
Content-Type: application/json

{
  "input": {
    "PostingDate": "2026-10-14",
    "Hospital": "01",
    "Modality": "01",
    "Items": [
      {
        "Material": "NS-000114",
        "Quantity": 3,
        "BUOM": "EA"
      },
      {
        "Material": "NS-000142",
        "Quantity": 1,
        "BUOM": "BOX"
      }
    ],
    "ClientRequestId": "SH-T-{{runId}}"
  }
}

