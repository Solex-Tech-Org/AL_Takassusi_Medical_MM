# =====================================================================
#  05 - receiveFromRis (this is how a NEW case row is created)
# =====================================================================

### RIS - Normal material (valid)
# EXPECT: بيعمل صف جديد، الـ ID بيتولّد في الـ server وبيرجع في RowResult.ID. Material بيتحدد من ProcedureCode
# @name ris_normal
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/receiveFromRis
Authorization: {{auth}}
Content-Type: application/json

{
  "rows": [
    {
      "CaseId": "T1-{{runId}}",
      "SourceRecordId": "SRC-T-{{runId}}-N1",
      "ProcedureCode": "PROC-CT-01",
      "ServiceDateTime": "2026-10-12T09:00:00Z",
      "Hospital": "01",
      "Modality": "01",
      "Quantity": 2,
      "EntryUnit": "EA",
      "Version": 1
    }
  ]
}

### Verify: new row visible in CaseConsumption
# @name ris_normal_chk
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption({{ris_normal.response.body.$.value[0].ID}})
Authorization: {{auth}}

### RIS - same SourceRecordId + same Version (duplicate)
# EXPECT: مفيش صف تاني (SourceRecordId unique)
# @name ris_dup
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/receiveFromRis
Authorization: {{auth}}
Content-Type: application/json

{
  "rows": [
    {
      "CaseId": "T1-{{runId}}",
      "SourceRecordId": "SRC-T-{{runId}}-N1",
      "ProcedureCode": "PROC-CT-01",
      "ServiceDateTime": "2026-10-12T09:00:00Z",
      "Hospital": "01",
      "Modality": "01",
      "Quantity": 2,
      "EntryUnit": "EA",
      "Version": 1
    }
  ]
}

### RIS - Version 2 updates Quantity
# EXPECT: ده الـ UPDATE: نفس الـ SourceRecordId بـ Version أكبر
# @name ris_update
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/receiveFromRis
Authorization: {{auth}}
Content-Type: application/json

{
  "rows": [
    {
      "CaseId": "T1-{{runId}}",
      "SourceRecordId": "SRC-T-{{runId}}-N1",
      "ProcedureCode": "PROC-CT-01",
      "ServiceDateTime": "2026-10-12T09:00:00Z",
      "Hospital": "01",
      "Modality": "01",
      "Quantity": 5,
      "EntryUnit": "EA",
      "Version": 2
    }
  ]
}

### Verify: Quantity is now 5
# @name ris_update_chk
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption({{ris_normal.response.body.$.value[0].ID}})
Authorization: {{auth}}

