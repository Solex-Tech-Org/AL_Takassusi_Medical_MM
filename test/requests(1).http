### Verify: SharedConsumptions has the record with items
# @name sh_post_chk
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/SharedConsumptions?$filter=SAPMaterialDocument%20eq%20'{{sh_post_ok.response.body.$.SAPMaterialDocument}}'&$expand=Items
Authorization: {{auth}}

### Verify: NursingShared log in SAPDocumentResults
# @name sh_post_log
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/SAPDocumentResults?$filter=Scenario%20eq%20'NursingShared'%20and%20SAPMaterialDocument%20eq%20'{{sh_post_ok.response.body.$.SAPMaterialDocument}}'
Authorization: {{auth}}

