GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/SharedConsumptions?$expand=Items
Authorization: {{auth}}

### CaseSessions - list with computed counts
# EXPECT: Seed: CS-0001 (8 total / 0 posted / Open) و CS-0002 (0/0/0 Completed)
# @name sess_list
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseSessions?$orderby=SessionNo
Authorization: {{auth}}


