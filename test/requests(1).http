# =====================================================================
#  03 - Sessions (openSession = create-or-get)
# =====================================================================

### openSession - new period
# EXPECT: يرجّع session جديدة (ID + SessionNo). ممكن تتكرر مرة تانية من غير ما تتعمل نسخة
# @name sess_new
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/openSession
Authorization: {{auth}}
Content-Type: application/json

{
  "dateFrom": "2026-11-01",
  "dateTo": "2026-11-07"
}

### openSession - same period again (idempotent)
# @name sess_same
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/openSession
Authorization: {{auth}}
Content-Type: application/json

{
  "dateFrom": "2026-11-01",
  "dateTo": "2026-11-07"
}

### openSession - existing seed period (CS-0001)
# EXPECT: Seed: Total 8 / Posted 0 / Remaining 8 / Open
# @name sess_existing
POST {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/openSession
Authorization: {{auth}}
Content-Type: application/json

{
  "dateFrom": "2026-10-05",
  "dateTo": "2026-10-11"
}

### CaseSessions - read the new session by key
# @name sess_one
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseSessions({{sess_new.response.body.$.ID}})
Authorization: {{auth}}

### CaseSessions - filter by SessionNo
# @name sess_filter
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseSessions?$filter=SessionNo%20eq%20'CS-0001'
Authorization: {{auth}}


