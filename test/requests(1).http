GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/HospitalModalities
Authorization: {{auth}}

### ConsumptionHistory - Posted
# EXPECT: Seed: 2 صفوف (2001, 2002)
# @name hist_list
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/ConsumptionHistory?$filter=Status%20eq%20'Posted'
Authorization: {{auth}}

### ConsumptionHistory - r09 by key
# @name hist_one
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/ConsumptionHistory({{r09}})
Authorization: {{auth}}

### SAPDocumentResults (PostingLogs)
# EXPECT: Seed: 4 logs (3 Success + 1 BusinessError)
# @name sap_list
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/SAPDocumentResults?$orderby=createdAt%20desc
Authorization: {{auth}}

### ConsumptionErrors
# @name errors
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/ConsumptionErrors
Authorization: {{auth}}

### SharedConsumptions + Items
