# =====================================================================
#  AAML Material Consumption - full API test file  (VS Code "REST Client")
#  افتح الملف في VS Code (extension: REST Client) واضغط "Send Request" فوق كل ###
#
#  مهم:
#   1) الداتا بتتغير (post/reverse). عشان ترجع للـ seed: اعمل restart لـ `cds watch`
#      (الـ DB in-memory والـ mock SAP كمان بيتصفّر).
#   2) شغّل الـ sections بالترتيب (00 -> 10): كل section معتمد على اللي قبله.
#   3) الـ requests اللي عليها name.response.body (request variables) لازم الـ request المصدر يتبعت الأول.
#   4) غيّر @runId كل مرة تشغّل section 05/10 من غير restart (عشان SourceRecordId مايتكررش).
# =====================================================================

@host = http://localhost:4004
@baseUrl = {{host}}

@auth = Basic YWxpY2U6

@runId = 1001

@r01 = 30000000-0000-0000-0000-000000000001
@r02 = 30000000-0000-0000-0000-000000000002
@r03 = 30000000-0000-0000-0000-000000000003
@r04 = 30000000-0000-0000-0000-000000000004
@r05 = 30000000-0000-0000-0000-000000000005
@r06 = 30000000-0000-0000-0000-000000000006
@r07 = 30000000-0000-0000-0000-000000000007
@r08 = 30000000-0000-0000-0000-000000000008
@r09 = 30000000-0000-0000-0000-000000000009
@r10 = 30000000-0000-0000-0000-000000000010
@r11 = 30000000-0000-0000-0000-000000000011
@r12 = 30000000-0000-0000-0000-000000000012
@r13 = 30000000-0000-0000-0000-000000000013
@r14 = 30000000-0000-0000-0000-000000000014
@r15 = 30000000-0000-0000-0000-000000000015
@r16 = 30000000-0000-0000-0000-000000000016
@r17 = 30000000-0000-0000-0000-000000000017
@r18 = 30000000-0000-0000-0000-000000000018
@sess1 = 90000000-0000-0000-0000-000000000001
@closeSeed = 50000000-0000-0000-0000-000000000001
@ghost = 00000000-0000-0000-0000-000000000000


# =====================================================================
#  00 - Smoke & Auth
# =====================================================================

### Service document
# EXPECT: 200 + قائمة بكل الـ entities. (في Postman بيعمل runId جديد لكل تشغيل)
# @name root
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/
Authorization: {{auth}}


### No credentials -> 401
# EXPECT: 401 (الـ service عليه @requires authenticated-user)
# @name noauth
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption


# =====================================================================
#  01 - READ every entity
# =====================================================================

### CaseConsumption - list
# EXPECT: Seed: 16 صف (Ready/Blocked). الـ Posted (CaseId 2001, 2002) مش بيظهروا.
# @name cc_list
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$count=true&$orderby=ServiceDate,CaseId
Authorization: {{auth}}

### CaseConsumption - by key (r01)
# EXPECT: CaseId 2011 / RM124 / Qty 2 (على داتا fresh)
# @name cc_one
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption({{r01}})
Authorization: {{auth}}

### CaseConsumption - Status = Ready
# @name cc_ready
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$filter=Status%20eq%20'Ready'
Authorization: {{auth}}

### CaseConsumption - Status = Blocked
# EXPECT: Seed: 4 صفوف (2014, 2018, 2025, 2026)
# @name cc_blocked
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$filter=Status%20eq%20'Blocked'
Authorization: {{auth}}

### CaseConsumption - period filter (same as UI)
# EXPECT: Seed: 8 صفوف = فترة CS-0001
# @name cc_period
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$filter=ServiceDate%20ge%202026-10-05%20and%20ServiceDate%20le%202026-10-11&$orderby=ServiceDate
Authorization: {{auth}}

### CaseConsumption - Hospital + Modality
# @name cc_hm
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$filter=Hospital%20eq%20'01'%20and%20Modality%20eq%20'01'
Authorization: {{auth}}

### CaseConsumption - Material contains (UI search)
# @name cc_mat
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$filter=contains(Material,'NM')%20or%20contains(MaterialDescription,'NM')
Authorization: {{auth}}

### CaseConsumption - $select/$top/$skip
# @name cc_page
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption?$select=ID,CaseId,Status&$orderby=CaseId&$top=3&$skip=1
Authorization: {{auth}}

### CaseConsumption - unknown ID -> 404
# @name cc_404
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption({{ghost}})
Authorization: {{auth}}

### CaseConsumption - already Posted row (r09) -> 404
# EXPECT: الـ projection فيها where Status in (...) فالـ Posted بيدّي 404 حتى لو بالـ ID
# @name cc_posted_hidden
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption({{r09}})
Authorization: {{auth}}

### CaseConsumption - malformed key -> 400
# @name cc_badkey
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/CaseConsumption(abc)
Authorization: {{auth}}

### ConsumptionTechnical - list (all statuses)
# EXPECT: Seed: 18 صف بكل الـ statuses وكل الحقول الـ technical
# @name tech_list
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/ConsumptionTechnical?$count=true
Authorization: {{auth}}

### ConsumptionTechnical - Posted row r09 with $expand
# @name tech_posted
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/ConsumptionTechnical({{r09}})?$expand=BatchAllocations,PostingLogs,ValidationEvents
Authorization: {{auth}}

### NuclearDetails - list
# @name nuc_list
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/NuclearDetails?$orderby=ServiceDate
Authorization: {{auth}}

### NuclearDetails - r02 + BatchAllocations
# EXPECT: على داتا fresh الـ allocations فاضية (مفيش seed ليها) - بتتملي بعد calculateNuclear/postSelected
# @name nuc_exp
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/NuclearDetails({{r02}})?$expand=BatchAllocations
Authorization: {{auth}}

### WasteReport
# EXPECT: Seed: 2 صفوف (Posted + Pending)
# @name waste
GET {{baseUrl}}/odata/v4/quality/MaterialConsumptionService/WasteReport
Authorization: {{auth}}

