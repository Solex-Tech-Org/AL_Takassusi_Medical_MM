<mvc:View
  controllerName="aaml.material.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  displayBlock="true"
  class="aamlShell"
  height="100%">
  <tnt:ToolPage id="toolPage" sideExpanded="true" class="aamlToolPage">
    <tnt:header>
      <tnt:ToolHeader class="aamlHeader">
        <Button icon="sap-icon://menu2" type="Transparent"
                tooltip="{i18n>toggleNav}" press=".onToggleSideNav"/>

        <!-- Left: title with subtitle underneath -->
        <VBox class="aamlHeaderBrand" renderType="Bare">
          <Title text="{i18n>appTitle}" level="H2" wrapping="false" class="aamlHeaderTitle"/>
          <Text text="{i18n>appSubtitle}" wrapping="false" class="aamlHeaderSubtitle"/>
        </VBox>

        <ToolbarSpacer/>

        <!-- Right: company name -->
        <Text text="{i18n>headerCompany}" wrapping="false" class="aamlHeaderCompany"/>
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" itemSelect=".onNavItemSelect">
        <tnt:item>
          <tnt:NavigationList>
            <tnt:NavigationListItem text="{i18n>navCase}" icon="sap-icon://list" key="case"/>
            <tnt:NavigationListItem text="{i18n>navShared}" icon="sap-icon://group" key="shared"/>
            <tnt:NavigationListItem text="{i18n>navReport}" icon="sap-icon://bar-chart" key="report"/>
          </tnt:NavigationList>
        </tnt:item>
        <tnt:fixedItem>
          <tnt:NavigationList>
            <tnt:NavigationListItem text="AAML network · 3 sites" icon="sap-icon://hospital" enabled="false"/>
          </tnt:NavigationList>
        </tnt:fixedItem>
      </tnt:SideNavigation>
    </tnt:sideContent>
    <tnt:mainContents>
      <NavContainer id="appNavContainer" height="100%"/>
    </tnt:mainContents>
  </tnt:ToolPage>

  <!-- Footer: full width under header + side nav + content -->
  <Toolbar class="aamlFooter" design="Solid">
    <Text text="{i18n>footerLeft}" wrapping="false" class="aamlFooterText"/>
    <ToolbarSpacer/>
    <Text text="{i18n>footerRight}" wrapping="false" class="aamlFooterText"/>
  </Toolbar>
</mvc:View>