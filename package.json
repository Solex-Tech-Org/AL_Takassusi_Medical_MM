
{
  "name": "AL_Takassusi_Medical_MM",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "sass": "^1.108.2"
  },
  "scripts": {
    "start": "cds-serve",
    "prewatch": "npm run build:styles",
    "build:styles": "sass app/css/style.scss app/css/style.css --no-source-map",
    "watch": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": "dummy",
      "destinations": true,
      "html5-repo": true,
      "AAML_ProductApi": {
        "kind": "odata-v2",
        "csrf": false,
        "credentials": {
          "destination": "AAML_Public_Cloud",
          "path": "/sap/opu/odata/sap/API_PRODUCT_SRV"
        }
      },
      "AAML_BatchApi": {
        "kind": "odata-v2",
        "csrf": false,
        "credentials": {
          "destination": "AAML_Public_Cloud",
          "path": "/sap/opu/odata/sap/API_BATCH_SRV"
        }
      },
      "AAML_MaterialStockApi": {
        "kind": "odata-v2",
        "csrf": false,
        "credentials": {
          "destination": "AAML_Public_Cloud",
          "path": "/sap/opu/odata/sap/API_MATERIAL_STOCK_SRV"
        }
      },
      "AAML_MaterialDocumentApi": {
        "kind": "odata-v2",
        "csrf": true,
        "credentials": {
          "destination": "AAML_Public_Cloud",
          "path": "/sap/opu/odata/sap/API_MATERIAL_DOCUMENT_SRV"
        }
      },
      "AAML_MaterialPostingApi": {
        "kind": "rest",
        "csrf": false,
        "credentials": {
          "destination": "AAML_Material_Posting"
        }
      },
      "AAML_SlocMappingApi": {
        "kind": "odata-v2",
        "csrf": false,
        "credentials": {
          "destination": "AAML_Public_Cloud",
          "path": "/"
        }
      }
    },
    "aaml": {
      "ris": {
        "serviceTimeZone": "",
        "fieldMap": {}
      },
      "productApi": {
        "destination": "AAML_Public_Cloud",
        "language": "EN"
      },
      "s4": {
        "mode": "mock",
        "readMode": "mock",
        "postingMode": "mock",
        "plant": "1100",
        "slocMappingPath": "",
        "slocMappingFields": {
          "plant": "Plant",
          "storageLocation": "StorageLocation",
          "hospitalSearchTerm": "AddressSearchTerm1",
          "modalitySearchTerm": "AddressSearchTerm2"
        },
        "goodsIssuePostPath": "/sap/bc/http/sap/zmm_mse_post_api",
        "goodsReceiptItemsPath": "/A_MaterialDocumentItem",
        "goodsReceiptHeaderPath": "/A_MaterialDocumentHeader",
        "goodsReceiptQuantityField": "QuantityInBaseUnit",
        "goodsReceiptPostingDateField": "PostingDate",
        "goodsReceiptMovementTypes": [
          "Z01"
        ],
        "wastePostingDateRule": "ServiceDate",
        "goodsIssueCaseLookupPath": "/A_MaterialDocumentItem",
        "goodsIssueCaseLookupField": "YY1_CaseID_MMI"
      }
    },
    "[hybrid]": {
      "aaml": {
        "s4": {
          "mode": "mock",
          "readMode": "remote",
          "postingMode": "mock",
          "casePostingMode": "remote"
        }
      }
    },
    "[production]": {
      "requires": {
        "auth": "dummy"
      },
      "aaml": {
        "s4": {
          "mode": "mock",
          "readMode": "remote",
          "postingMode": "mock",
          "casePostingMode": "remote"
        }
      }
    }
  }
}
